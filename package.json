{
  "name": "paco",
  "displayName": "PACO: aprende Java con bloques (Visual Java Editor)",
  "description": "Arrastra bloques estilo Scratch y mira cómo se convierten en Java real al instante. Ejecuta con un clic. Learn Java visually with Scratch-style blocks that generate compilable Java in real time.",
  "version": "0.5.0",
  "publisher": "FranciscoSZ",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PakoPakete/paco"
  },
  "homepage": "https://github.com/PakoPakete/paco#readme",
  "bugs": {
    "url": "https://github.com/PakoPakete/paco/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "java",
    "blockly",
    "scratch",
    "bloques",
    "blocks",
    "programación visual",
    "aprender java",
    "visual programming",
    "learn java",
    "beginner",
    "education",
    "teaching",
    "students",
    "code generation",
    "no-code"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pacoContainer",
          "title": "PACO",
          "icon": "images/icon-activity-bar.svg"
        }
      ]
    },
    "views": {
      "pacoContainer": [
        {
          "id": "pacoView",
          "name": "PACO – Visual Java Editor"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pacoView",
        "contents": "Editor visual de bloques que genera código Java en tiempo real.\n\n[$(play) Abrir Editor PACO](command:paco.openEditor)"
      }
    ],
    "customEditors": [
      {
        "viewType": "paco.blockEditor",
        "displayName": "PACO - Editor de bloques",
        "selector": [
          {
            "filenamePattern": "*.paco"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "paco.openEditor",
        "title": "PACO: Abrir Editor Visual de Java",
        "icon": "images/icon-activity-bar.svg"
      },
      {
        "command": "paco.runJava",
        "title": "PACO: Ejecutar programa Java",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "paco.runJava",
          "when": "activeCustomEditorId == paco.blockEditor",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src",
    "test": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "test:vscode": "npm run compile-tests && npm run compile && npm run lint && vscode-test",
    "vsix": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "blockly": "^12.3.1",
    "eslint": "^9.39.1",
    "mocha": "^12.0.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": "$mocha"
    }
  },
  "pricing": "Free",
  "qna": "https://github.com/PakoPakete/paco/issues"
}
